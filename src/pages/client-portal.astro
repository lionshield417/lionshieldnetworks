---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
---

<Layout
	title="Client Portal | LionShield Networks"
	description="Access LionShield Networks client resources and IT support services."
>
	<Navbar />

	<main class="min-h-screen bg-slate-950 text-white">
		<section class="mx-auto max-w-7xl px-6 py-20">
			<div class="mx-auto max-w-3xl text-center">
				<p class="text-sm font-semibold uppercase tracking-widest text-blue-400">
					LionShield Networks
				</p>

				<h1 class="mt-4 text-4xl font-bold md:text-6xl">
					Client Portal
				</h1>

				<p class="mt-6 text-lg leading-8 text-slate-300">
					Access billing, support, scheduling, and other client resources
					from one convenient location.
				</p>
			</div>

			<div class="mx-auto mt-14 grid max-w-5xl gap-6 md:grid-cols-2">
				<a
					href="https://www.paypal.com/ncp/payment/A7GV5CESXR5BS"
					target="_blank"
					rel="noopener noreferrer"
					class="group rounded-2xl border border-yellow-400/40 bg-slate-900 p-8 transition hover:-translate-y-1 hover:border-yellow-300"
				>
					<div class="flex h-12 w-12 items-center justify-center rounded-xl bg-yellow-400 text-2xl">
						💳
					</div>

					<h2 class="mt-6 text-2xl font-bold group-hover:text-yellow-300">
						Pay an Invoice
					</h2>

					<p class="mt-3 leading-7 text-slate-300">
						Make a secure payment using the LionShield Networks PayPal
						payment page.
					</p>

					<p class="mt-6 font-semibold text-yellow-300">
						Open payment page →
					</p>
				</a>

				<div class="rounded-2xl border border-slate-800 bg-slate-900 p-8">
					<div class="flex h-12 w-12 items-center justify-center rounded-xl bg-blue-600 text-2xl">
						🎫
					</div>

					<h2 class="mt-6 text-2xl font-bold">
						Submit a Support Ticket
					</h2>

					<p class="mt-3 leading-7 text-slate-300">
						Request technical assistance from the LionShield Networks
						support team.
					</p>

					<p class="mt-6 text-sm font-semibold uppercase tracking-wide text-slate-500">
						Coming soon
					</p>
				</div>

				<div class="rounded-2xl border border-slate-800 bg-slate-900 p-8">
					<div class="flex h-12 w-12 items-center justify-center rounded-xl bg-blue-600 text-2xl">
						📅
					</div>

					<h2 class="mt-6 text-2xl font-bold">
						Schedule Support
					</h2>

					<p class="mt-3 leading-7 text-slate-300">
						Reserve a convenient time for remote or onsite technical
						support.
					</p>

					<p class="mt-6 text-sm font-semibold uppercase tracking-wide text-slate-500">
						Coming soon
					</p>
				</div>

				<div class="rounded-2xl border border-slate-800 bg-slate-900 p-8">
					<div class="flex h-12 w-12 items-center justify-center rounded-xl bg-blue-600 text-2xl">
						🖥️
					</div>

					<h2 class="mt-6 text-2xl font-bold">
						Remote Support
					</h2>

					<p class="mt-3 leading-7 text-slate-300">
						Download the approved remote-support application provided by
						your technician.
					</p>

					<p class="mt-6 text-sm font-semibold uppercase tracking-wide text-slate-500">
						Coming soon
					</p>
				</div>
			</div>

			<div class="mx-auto mt-12 max-w-5xl rounded-2xl border border-blue-500/30 bg-blue-950/30 p-6 text-center">
				<p class="text-slate-300">
					Need immediate assistance? Contact LionShield Networks directly
					before submitting payment or downloading support software.
				</p>

				<a
					href="/contact"
					class="mt-5 inline-block rounded-lg bg-blue-600 px-6 py-3 font-semibold text-white hover:bg-blue-500"
				>
					Contact Support
				</a>
			</div>
		</section>
	</main>
</Layout>