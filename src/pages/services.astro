---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';

import {
	ArrowRight,
	ShieldCheck,
	Headphones,
	MonitorCog,
	Cloud,
	Network,
	BriefcaseBusiness,
	Search,
	ClipboardList,
	Settings,
	Shield,
	LifeBuoy,
} from 'lucide-astro';
---

<Layout
	title="Managed IT Services & Cybersecurity | LionShield Networks"
	description="Explore managed IT, cybersecurity, Microsoft 365, cloud solutions, networking, backup, disaster recovery, and proactive business IT support from LionShield Networks."
>
	<div class="min-h-screen bg-[#020611] text-white">
		<Navbar />

		<main>
			<!-- SERVICES HERO -->
			<section
				class="relative min-h-[740px] overflow-hidden border-b border-cyan-400/20"
			>
				<div class="absolute inset-0">
					<img
						src="/images/services-technology-illustration.png"
						alt=""
						class="absolute inset-0 h-full w-full scale-90 object-contain object-[100%_center]"
					/>

					<div class="absolute inset-0 bg-[#020611]/30"></div>

					<div
						class="absolute inset-0 bg-gradient-to-r from-[#020611] via-[#020611]/60 via-[35%] to-transparent"
					></div>

					<div
						class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-[#020611] to-transparent"
					></div>
				</div>

				<div
					class="relative z-10 mx-auto flex min-h-[740px] max-w-[1450px] items-center px-6 lg:px-10"
				>
					<div class="max-w-[620px]">
						<p
							class="text-sm font-bold uppercase tracking-[0.34em] text-cyan-400 sm:text-base"
						>
							Managed IT Services
						</p>

						<div
							class="mt-5 h-px w-72 bg-gradient-to-r from-cyan-400 via-blue-400 to-transparent"
						></div>

						<h1
							class="mt-8 text-5xl font-black uppercase leading-[0.98] tracking-[-0.04em] sm:text-6xl lg:text-[4.2rem]"
						>
							Technology that keeps

							<span class="block text-yellow-400">
								your business moving.
							</span>
						</h1>

						<p class="mt-7 max-w-[590px] text-lg leading-8 text-slate-300">
							From proactive support and cybersecurity to Microsoft 365,
							networking, and business continuity, LionShield Networks
							delivers the technology foundation your business needs to
							operate securely and grow confidently.
						</p>

						<div class="mt-9 flex flex-col gap-4 sm:flex-row">
							<a
								href="/contact"
								class="inline-flex items-center justify-center rounded-xl border border-cyan-300/70 bg-blue-600 px-8 py-4 font-bold text-white shadow-[0_0_30px_rgba(37,99,235,0.45)] transition duration-300 hover:-translate-y-1 hover:bg-blue-500"
							>
								Request a Free Assessment
							</a>

							<a
								href="#managed-it"
								class="group inline-flex items-center justify-center gap-3 rounded-xl border border-yellow-400/70 bg-black/40 px-8 py-4 font-bold text-yellow-300 transition duration-300 hover:-translate-y-1 hover:bg-yellow-400 hover:text-black"
							>
								Explore Our Services

								<ArrowRight
									class="h-5 w-5 transition-transform duration-300 group-hover:translate-x-1"
									stroke-width={2}
								/>
							</a>
						</div>

						<div
							class="mt-10 inline-flex items-center gap-3 rounded-lg border border-yellow-400/20 bg-black/50 px-5 py-3 backdrop-blur-sm"
						>
							<span class="text-lg text-yellow-400">📖</span>

							<p class="text-sm font-bold text-yellow-400">
								Proverbs 3:5–6
							</p>

							<p class="hidden text-sm text-slate-400 lg:block">
								Trust in the Lord with all your heart...
							</p>
						</div>
					</div>
				</div>
			</section>
           

			<!-- MANAGED IT SERVICES -->
			<section
				id="managed-it"
				class="relative overflow-hidden border-b border-cyan-400/10 bg-[#030914] px-6 pt-24 pb-20 lg:px-10 lg:py-24"
			>
				<div
					class="pointer-events-none absolute -left-40 top-1/2 h-[500px] w-[500px] -translate-y-1/2 rounded-full bg-blue-600/10 blur-[170px]"
				></div>

				<div
					class="relative mx-auto grid max-w-[1450px] items-center gap-14 lg:grid-cols-[0.78fr_1.22fr] lg:gap-16"
				>
					<div>
						<div class="flex items-center gap-4">
							<p class="text-lg font-black tracking-[0.25em] text-cyan-400">
								01
							</p>

							<div
								class="h-px w-16 bg-gradient-to-r from-cyan-400 to-transparent"
							></div>
						</div>

						<h2 class="mt-5 text-4xl font-black leading-tight sm:text-5xl">
							Managed IT Services
						</h2>

						<p class="mt-4 max-w-xl leading-7 text-slate-300">
							Proactive monitoring, maintenance, and support to keep your
							business running smoothly and securely.
						</p>

						<div class="mt-7 grid gap-4 sm:grid-cols-2">
							<div class="flex items-center gap-3">
								<ShieldCheck class="h-5 w-5 text-cyan-300" stroke-width={2} />
								<span>24/7 System Monitoring</span>
							</div>

							<div class="flex items-center gap-3">
								<ShieldCheck class="h-5 w-5 text-cyan-300" stroke-width={2} />
								<span>Help Desk Support</span>
							</div>

							<div class="flex items-center gap-3">
								<ShieldCheck class="h-5 w-5 text-cyan-300" stroke-width={2} />
								<span>Patch Management</span>
							</div>

							<div class="flex items-center gap-3">
								<ShieldCheck class="h-5 w-5 text-cyan-300" stroke-width={2} />
								<span>Asset Management</span>
							</div>
						</div>

						<div class="mt-8 grid gap-3 sm:grid-cols-3">
							<div class="rounded-xl border border-cyan-300/20 bg-black/25 p-4">
								<p class="text-xs uppercase tracking-wider text-slate-400">
									Devices Managed
								</p>
								<p class="mt-2 text-3xl font-black">248</p>
							</div>

							<div class="rounded-xl border border-cyan-300/20 bg-black/25 p-4">
								<p class="text-xs uppercase tracking-wider text-slate-400">
									Alerts Resolved
								</p>
								<p class="mt-2 text-3xl font-black">97%</p>
							</div>

							<div class="rounded-xl border border-cyan-300/20 bg-black/25 p-4">
								<p class="text-xs uppercase tracking-wider text-slate-400">
									System Uptime
								</p>
								<p class="mt-2 text-3xl font-black">99.99%</p>
							</div>
						</div>
					</div>

					<div
						class="relative overflow-hidden rounded-2xl border border-cyan-300/20 bg-black/20"
					>
						<img
							src="/images/managed-it-services.png"
							alt="Managed IT services monitoring center"
							class="min-h-[420px] w-full object-cover object-center"
						/>
					</div>
				</div>
			</section>

			<!-- CYBERSECURITY -->
			<section
				id="cybersecurity"
				class="relative overflow-hidden border-b border-cyan-400/10 bg-[#020611] px-6 pt-24 pb-20 lg:px-10 lg:py-24"
			>
				<div
					class="relative mx-auto grid max-w-[1450px] items-center gap-14 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16"
				>
					<div
						class="relative overflow-hidden rounded-2xl border border-cyan-300/20 bg-black/20"
					>
						<img
							src="/images/cybersecurity-services.png"
							alt="Cybersecurity monitoring and protection"
							class="min-h-[430px] w-full object-cover object-center"
						/>
					</div>

					<div>
						<div class="flex items-center gap-4">
							<p class="text-lg font-black tracking-[0.25em] text-cyan-400">
								02
							</p>

							<div
								class="h-px w-16 bg-gradient-to-r from-cyan-400 to-transparent"
							></div>
						</div>

						<h2 class="mt-5 text-4xl font-black leading-tight sm:text-5xl">
							Cybersecurity
							<span class="block text-yellow-400">Protection</span>
						</h2>

						<p class="mt-5 text-lg leading-8 text-slate-300">
							Layered protection for your users, devices, email, identities,
							cloud services, and critical business data.
						</p>

						<div class="mt-8 grid gap-4 sm:grid-cols-2">
							<div class="flex items-center gap-3">
								<ShieldCheck class="h-5 w-5 text-cyan-300" stroke-width={2} />
								<span>Endpoint Protection</span>
							</div>

							<div class="flex items-center gap-3">
								<ShieldCheck class="h-5 w-5 text-cyan-300" stroke-width={2} />
								<span>Email Security</span>
							</div>

							<div class="flex items-center gap-3">
								<ShieldCheck class="h-5 w-5 text-cyan-300" stroke-width={2} />
								<span>Ransomware Defense</span>
							</div>

							<div class="flex items-center gap-3">
								<ShieldCheck class="h-5 w-5 text-cyan-300" stroke-width={2} />
								<span>Threat Monitoring</span>
							</div>
						</div>
					</div>
				</div>
			</section>
            <!-- MICROSOFT 365 & CLOUD -->
<section
	id="microsoft-365"
	class="relative overflow-hidden border-b border-cyan-400/10 bg-[#030914] px-6 pt-24 pb-20 lg:px-10 lg:py-24"
>
	<div
		class="pointer-events-none absolute -left-40 top-1/2 h-[520px] w-[520px] -translate-y-1/2 rounded-full bg-blue-600/10 blur-[170px]"
	></div>

	<div
		class="relative mx-auto grid max-w-[1450px] items-center gap-14 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16"
	>
		<!-- Left content -->
		<div>
			<div class="flex items-center gap-4">
				<p class="text-lg font-black tracking-[0.25em] text-cyan-400">
					03
				</p>

				<div
					class="h-px w-16 bg-gradient-to-r from-cyan-400 to-transparent"
				></div>
			</div>

			<h2 class="mt-5 text-4xl font-black leading-tight sm:text-5xl">
				Microsoft 365
				<span class="block text-yellow-400">
					& Cloud
				</span>
			</h2>

			<p class="mt-5 max-w-xl text-lg leading-8 text-slate-300">
				Secure cloud productivity, collaboration, identity management, and
				business continuity designed around the way your team works.
			</p>

			<div class="mt-8 grid gap-4 sm:grid-cols-2">
				<div class="flex items-center gap-3">
					<ShieldCheck
						class="h-5 w-5 shrink-0 text-cyan-300"
						stroke-width={2}
					/>
					<span class="text-slate-200">Microsoft 365 Management</span>
				</div>

				<div class="flex items-center gap-3">
					<ShieldCheck
						class="h-5 w-5 shrink-0 text-cyan-300"
						stroke-width={2}
					/>
					<span class="text-slate-200">Exchange Online</span>
				</div>

				<div class="flex items-center gap-3">
					<ShieldCheck
						class="h-5 w-5 shrink-0 text-cyan-300"
						stroke-width={2}
					/>
					<span class="text-slate-200">Microsoft Teams</span>
				</div>

				<div class="flex items-center gap-3">
					<ShieldCheck
						class="h-5 w-5 shrink-0 text-cyan-300"
						stroke-width={2}
					/>
					<span class="text-slate-200">SharePoint & OneDrive</span>
				</div>

				<div class="flex items-center gap-3">
					<ShieldCheck
						class="h-5 w-5 shrink-0 text-cyan-300"
						stroke-width={2}
					/>
					<span class="text-slate-200">Entra ID & Intune</span>
				</div>

				<div class="flex items-center gap-3">
					<ShieldCheck
						class="h-5 w-5 shrink-0 text-cyan-300"
						stroke-width={2}
					/>
					<span class="text-slate-200">Cloud Backup</span>
				</div>
			</div>

			<a
				href="/contact"
				class="group mt-8 inline-flex items-center gap-3 font-bold text-cyan-300 transition-colors duration-300 hover:text-white"
			>
				Modernize Your Workplace

				<ArrowRight
					class="h-5 w-5 transition-transform duration-300 group-hover:translate-x-1"
					stroke-width={2}
				/>
			</a>
		</div>

		<!-- Right image -->
		<div
			class="relative overflow-hidden rounded-2xl border border-cyan-300/20 bg-black/20 shadow-[0_0_40px_rgba(34,211,238,0.08)]"
		>
			<img
				src="/images/microsoft-365-cloud.png"
				alt="Microsoft 365 and cloud services"
				class="h-full min-h-[430px] w-full object-cover object-center"
			/>

			<div
				class="pointer-events-none absolute inset-0 bg-gradient-to-r from-[#030914]/15 to-transparent"
			></div>
		</div>
	</div>
</section>
<!-- NETWORK INFRASTRUCTURE -->
<section
	id="networking"
	class="relative overflow-hidden border-b border-cyan-400/10 bg-[#020611] px-6 pt-24 pb-20 lg:px-10 lg:py-24"
>
	<div
		class="relative mx-auto grid max-w-[1450px] items-center gap-16 lg:grid-cols-[1.15fr_0.85fr]"
	>

		<!-- Image -->
		<div
			class="overflow-hidden rounded-2xl border border-cyan-300/20 bg-black/20 shadow-[0_0_40px_rgba(34,211,238,0.08)]"
		>
			<img
				src="/images/network-infrastructure.png"
				alt="Enterprise Network Infrastructure"
				class="h-full min-h-[440px] w-full object-cover object-center"
			/>
		</div>

		<!-- Text -->
		<div>

			<div class="flex items-center gap-4">
				<p class="text-lg font-black tracking-[0.25em] text-cyan-400">
					04
				</p>

				<div
					class="h-px w-16 bg-gradient-to-r from-cyan-400 to-transparent"
				></div>
			</div>

			<h2 class="mt-5 text-4xl font-black leading-tight sm:text-5xl">
				Network Infrastructure
				<span class="block text-yellow-400">
					Built for Speed.
				</span>
			</h2>

			<p class="mt-6 text-lg leading-8 text-slate-300">
				Reliable networking is the backbone of every successful
				business. We design, deploy and support secure wired and
				wireless infrastructure that keeps your organization connected
				and productive.
			</p>

			<div class="mt-8 grid gap-4 sm:grid-cols-2">

				<div class="flex items-center gap-3">
					<ShieldCheck class="h-5 w-5 text-cyan-300" stroke-width={2}/>
					<span>Enterprise Wi-Fi</span>
				</div>

				<div class="flex items-center gap-3">
					<ShieldCheck class="h-5 w-5 text-cyan-300" stroke-width={2}/>
					<span>Business Switching</span>
				</div>

				<div class="flex items-center gap-3">
					<ShieldCheck class="h-5 w-5 text-cyan-300" stroke-width={2}/>
					<span>Next-Gen Firewalls</span>
				</div>

				<div class="flex items-center gap-3">
					<ShieldCheck class="h-5 w-5 text-cyan-300" stroke-width={2}/>
					<span>VPN Connectivity</span>
				</div>

				<div class="flex items-center gap-3">
					<ShieldCheck class="h-5 w-5 text-cyan-300" stroke-width={2}/>
					<span>Structured Cabling</span>
				</div>

				<div class="flex items-center gap-3">
					<ShieldCheck class="h-5 w-5 text-cyan-300" stroke-width={2}/>
					<span>24/7 Network Monitoring</span>
				</div>

			</div>

		</div>

	</div>
</section>
<!-- BACKUP & DISASTER RECOVERY -->
<section
	id="backup-recovery"
	class="relative overflow-hidden border-b border-cyan-400/10 bg-[#030914] px-6 pt-24 pb-20 lg:px-10 lg:py-24"
>
	<div
		class="pointer-events-none absolute -left-40 top-1/2 h-[520px] w-[520px] -translate-y-1/2 rounded-full bg-blue-600/10 blur-[170px]"
	></div>

	<div
		class="relative mx-auto grid max-w-[1450px] items-center gap-14 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16"
	>
		<!-- Left content -->
		<div>
			<div class="flex items-center gap-4">
				<p class="text-lg font-black tracking-[0.25em] text-cyan-400">
					05
				</p>

				<div
					class="h-px w-16 bg-gradient-to-r from-cyan-400 to-transparent"
				></div>
			</div>

			<h2 class="mt-5 text-4xl font-black leading-tight sm:text-5xl">
				Backup & Disaster
				<span class="block text-yellow-400">
					Recovery
				</span>
			</h2>

			<p class="mt-5 max-w-xl text-lg leading-8 text-slate-300">
				Data loss can happen in seconds. Our layered backup and disaster
				recovery solutions help protect your business from ransomware,
				hardware failure, accidental deletion, and unexpected outages.
			</p>

			<div class="mt-8 grid gap-4 sm:grid-cols-2">
				<div class="flex items-center gap-3">
					<ShieldCheck
						class="h-5 w-5 shrink-0 text-cyan-300"
						stroke-width={2}
					/>
					<span class="text-slate-200">Cloud Backups</span>
				</div>

				<div class="flex items-center gap-3">
					<ShieldCheck
						class="h-5 w-5 shrink-0 text-cyan-300"
						stroke-width={2}
					/>
					<span class="text-slate-200">Ransomware Recovery</span>
				</div>

				<div class="flex items-center gap-3">
					<ShieldCheck
						class="h-5 w-5 shrink-0 text-cyan-300"
						stroke-width={2}
					/>
					<span class="text-slate-200">Local & Offsite Replication</span>
				</div>

				<div class="flex items-center gap-3">
					<ShieldCheck
						class="h-5 w-5 shrink-0 text-cyan-300"
						stroke-width={2}
					/>
					<span class="text-slate-200">Bare-Metal Restore</span>
				</div>

				<div class="flex items-center gap-3">
					<ShieldCheck
						class="h-5 w-5 shrink-0 text-cyan-300"
						stroke-width={2}
					/>
					<span class="text-slate-200">Recovery Planning</span>
				</div>

				<div class="flex items-center gap-3">
					<ShieldCheck
						class="h-5 w-5 shrink-0 text-cyan-300"
						stroke-width={2}
					/>
					<span class="text-slate-200">Backup Monitoring & Testing</span>
				</div>
			</div>

			<a
				href="/contact"
				class="group mt-8 inline-flex items-center gap-3 font-bold text-cyan-300 transition-colors duration-300 hover:text-white"
			>
				Protect What Matters

				<ArrowRight
					class="h-5 w-5 transition-transform duration-300 group-hover:translate-x-1"
					stroke-width={2}
				/>
			</a>
		</div>

		<!-- Right image -->
		<div
			class="relative overflow-hidden rounded-2xl border border-cyan-300/20 bg-black/20 shadow-[0_0_40px_rgba(34,211,238,0.08)]"
		>
			<img
				src="/images/backup-disaster-recovery.png"
				alt="Secure cloud backup and disaster recovery system"
				class="h-full min-h-[440px] w-full object-cover object-center"
			/>

			<div
				class="pointer-events-none absolute inset-0 bg-gradient-to-r from-[#030914]/15 to-transparent"
			></div>
		</div>
	</div>
</section>
<!-- IT SUPPORT & HELP DESK -->
<section
	id="it-support"
	class="relative overflow-hidden border-b border-cyan-400/10 bg-[#020611] px-6 pt-24 pb-20 lg:px-10 lg:py-24"
>
	<div
		class="pointer-events-none absolute -right-40 top-1/2 h-[520px] w-[520px] -translate-y-1/2 rounded-full bg-cyan-500/10 blur-[170px]"
	></div>

	<div
		class="relative mx-auto grid max-w-[1450px] items-center gap-14 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16"
	>
		<!-- Left image -->
		<div
			class="relative overflow-hidden rounded-2xl border border-cyan-300/20 bg-black/20 shadow-[0_0_40px_rgba(34,211,238,0.08)]"
		>
			<img
				src="/images/it-help-desk.png"
				alt="IT help desk and remote support center"
				class="h-full min-h-[440px] w-full object-cover object-center"
			/>

			<div
				class="pointer-events-none absolute inset-0 bg-gradient-to-r from-transparent via-transparent to-[#020611]/25"
			></div>
		</div>

		<!-- Right content -->
		<div>
			<div class="flex items-center gap-4">
				<p class="text-lg font-black tracking-[0.25em] text-cyan-400">
					06
				</p>

				<div
					class="h-px w-16 bg-gradient-to-r from-cyan-400 to-transparent"
				></div>
			</div>

			<h2 class="mt-5 text-4xl font-black leading-tight sm:text-5xl">
				IT Support
				<span class="block text-yellow-400">
					When You Need It
				</span>
			</h2>

			<p class="mt-5 max-w-xl text-lg leading-8 text-slate-300">
				Fast, friendly support for users, computers, applications, and
				devices. We help resolve issues quickly so your team can stay
				productive and focused.
			</p>

			<div class="mt-8 grid gap-4 sm:grid-cols-2">
				<div class="flex items-center gap-3">
					<ShieldCheck
						class="h-5 w-5 shrink-0 text-cyan-300"
						stroke-width={2}
					/>
					<span class="text-slate-200">Remote Help Desk</span>
				</div>

				<div class="flex items-center gap-3">
					<ShieldCheck
						class="h-5 w-5 shrink-0 text-cyan-300"
						stroke-width={2}
					/>
					<span class="text-slate-200">Onsite Support</span>
				</div>

				<div class="flex items-center gap-3">
					<ShieldCheck
						class="h-5 w-5 shrink-0 text-cyan-300"
						stroke-width={2}
					/>
					<span class="text-slate-200">User Troubleshooting</span>
				</div>

				<div class="flex items-center gap-3">
					<ShieldCheck
						class="h-5 w-5 shrink-0 text-cyan-300"
						stroke-width={2}
					/>
