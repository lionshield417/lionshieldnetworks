---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';

import {
	CheckCircle2,
	Home,
	Mail,
	Phone,
	ShieldCheck,
	ArrowRight,
} from 'lucide-astro';
---

<Layout
	title="Thank You for Your Payment | LionShield Networks"
	description="Thank you for your payment to LionShield Networks."
	noindex={true}
>
	<div class="min-h-screen bg-[#020611] text-white">
		<Navbar />

		<main>
			<section
				class="relative flex min-h-screen items-center overflow-hidden border-b border-cyan-400/20 px-6 pb-24 pt-36 lg:px-10 lg:pt-40"
			>
				<!-- Background glow -->
				<div
					class="pointer-events-none absolute left-1/2 top-[30%] h-[650px] w-[650px] -translate-x-1/2 rounded-full bg-cyan-500/10 blur-[190px]"
				></div>

				<div
					class="pointer-events-none absolute -right-40 top-20 h-[500px] w-[500px] rounded-full bg-blue-600/10 blur-[170px]"
				></div>

				<div
					class="pointer-events-none absolute -left-40 bottom-0 h-[450px] w-[450px] rounded-full bg-yellow-400/5 blur-[170px]"
				></div>

				<!-- Grid background -->
				<div
					class="pointer-events-none absolute inset-0 opacity-[0.035]"
					style="background-image:
						linear-gradient(rgba(34,211,238,.20) 1px, transparent 1px),
						linear-gradient(90deg, rgba(34,211,238,.20) 1px, transparent 1px);
						background-size: 34px 34px;"
				></div>

				<div class="relative mx-auto w-full max-w-[900px]">
					<div
						class="relative overflow-hidden rounded-3xl border border-cyan-300/20 bg-black/30 px-6 py-12 text-center shadow-[0_0_70px_rgba(34,211,238,0.10)] backdrop-blur-md sm:px-12 sm:py-16"
					>
						<!-- Card glow -->
						<div
							class="pointer-events-none absolute inset-0 bg-gradient-to-br from-cyan-500/5 via-transparent to-blue-600/5"
						></div>

						<div class="relative">
							<!-- Success icon -->
							<div
								class="mx-auto flex h-24 w-24 items-center justify-center rounded-full border border-cyan-300/40 bg-cyan-500/10 shadow-[0_0_40px_rgba(34,211,238,0.20)]"
							>
								<CheckCircle2
									class="h-12 w-12 text-cyan-300"
									stroke-width={1.6}
								/>
							</div>

							<p
								class="mt-8 text-sm font-bold uppercase tracking-[0.34em] text-cyan-400 sm:text-base"
							>
								Payment Received
							</p>

							<div
								class="mx-auto mt-5 h-px w-64 bg-gradient-to-r from-transparent via-cyan-400 to-transparent"
							></div>

							<h1
								class="mt-8 text-5xl font-black uppercase leading-none tracking-[-0.04em] sm:text-6xl"
							>
								Thank
								<span class="text-yellow-400"> You.</span>
							</h1>

							<p
								class="mx-auto mt-7 max-w-[650px] text-lg leading-8 text-slate-300"
							>
								Thank you for your payment to
								<strong class="text-white">LionShield Networks</strong>.
								Your payment has been submitted successfully.
							</p>

							<p
								class="mx-auto mt-4 max-w-[650px] leading-7 text-slate-400"
							>
								We appreciate your business and the opportunity to support
								your technology needs.
							</p>

							<!-- Confirmation box -->
							<div
								class="mx-auto mt-10 max-w-[620px] rounded-2xl border border-cyan-300/15 bg-[#06111e]/80 p-6"
							>
								<div class="flex items-center justify-center gap-3">
									<ShieldCheck
										class="h-6 w-6 text-yellow-400"
										stroke-width={1.8}
									/>

									<p class="font-bold text-white">
										Your payment was processed through PayPal.
									</p>
								</div>

								<p class="mt-3 text-sm leading-6 text-slate-400">
									Please retain your PayPal payment confirmation for your
									records.
								</p>
							</div>

							<!-- Contact information -->
							<div class="mt-10">
								<p
									class="text-sm font-bold uppercase tracking-[0.25em] text-yellow-400"
								>
									Need Assistance?
								</p>

								<div
									class="mt-5 flex flex-col items-center justify-center gap-4 sm:flex-row sm:gap-8"
								>
									<a
										href="tel:+12124989544"
										class="track-payment-phone inline-flex items-center gap-2 text-slate-300 transition hover:text-cyan-300"
									>
										<Phone
											class="h-5 w-5 text-cyan-300"
											stroke-width={1.8}
										/>
										212-498-9544
									</a>

									<a
										href="mailto:support@lionshieldnetworks.com"
										class="inline-flex items-center gap-2 text-slate-300 transition hover:text-cyan-300"
									>
										<Mail
											class="h-5 w-5 text-cyan-300"
											stroke-width={1.8}
										/>
										support@lionshieldnetworks.com
									</a>
								</div>
							</div>

							<!-- Buttons -->
							<div
								class="mt-10 flex flex-col justify-center gap-4 sm:flex-row"
							>
								<a
									href="/"
									class="group inline-flex items-center justify-center gap-3 rounded-xl border border-cyan-300/70 bg-blue-600 px-7 py-3.5 font-bold text-white shadow-[0_0_30px_rgba(37,99,235,0.35)] transition duration-300 hover:-translate-y-1 hover:bg-blue-500"
								>
									<Home
										class="h-5 w-5"
										stroke-width={1.8}
									/>
									Return Home
								</a>

								<a
									href="/contact/"
									class="group inline-flex items-center justify-center gap-3 rounded-xl border border-yellow-400/50 bg-yellow-400/10 px-7 py-3.5 font-bold text-yellow-300 transition duration-300 hover:-translate-y-1 hover:bg-yellow-400/20"
								>
									Contact Support

									<ArrowRight
										class="h-5 w-5 transition-transform duration-300 group-hover:translate-x-1"
										stroke-width={2}
									/>
								</a>
							</div>

							<p class="mt-12 text-xs uppercase tracking-[0.2em] text-slate-600">
								Secure. Connect. Protect.
							</p>
						</div>
					</div>
				</div>
			</section>
		</main>
	</div>

	<!-- GA4 Payment Completion Tracking -->
	<script>
		const gtag = (window as any).gtag;

		if (typeof gtag === 'function') {
			gtag('event', 'payment_thank_you_view', {
				event_category: 'payment',
				event_label: 'paypal_payment',
			});
		}
	</script>

	<!-- GA4 Phone Click Tracking -->
	<script>
		document
			.querySelectorAll('.track-payment-phone')
			.forEach((link) => {
				link.addEventListener('click', () => {
					const gtag = (window as any).gtag;

					if (typeof gtag === 'function') {
						gtag('event', 'phone_click', {
							event_category: 'lead',
							event_label: 'payment_thank_you_page',
						});
					}
				});
			});
	</script>
</Layout>